{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "decompiler",
  "version": "0.10.0",
  "identifier": "moe.sota.decompiler",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Decompiler",
        "width": 1000,
        "height": 650,
        "minWidth": 500,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../jvm/build/libs/jvm.jar": "jvm.jar"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
